{
  "name": "tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint-fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "prettier --write src/ fixtures/ e2e/ playwright.config.ts",
    "format:check": "prettier --check src/ fixtures/ e2e/ playwright.config.ts",
    "tokens": "python3 scripts/design_preview.py brand/design-system --tokens-css src/styles/tokens.css --dark-selector .dark && grep -v '^@font-face' src/styles/tokens.css > src/styles/tokens.css.tmp && mv src/styles/tokens.css.tmp src/styles/tokens.css",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@lucide/vue": "^1.61.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "markdown-it": "^14.3.3",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "~4.10.0",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "eslint-plugin-vuejs-accessibility": "~2.6.3",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
