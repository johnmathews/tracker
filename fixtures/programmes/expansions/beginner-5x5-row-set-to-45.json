          "step": 2.5
        }
      },
      {
        "key": "deadlift",
        "name": "Deadlift",
        "notes": "Hinge, don’t squat. Bar close to the shins.",
        "target": 3,
        "sets": 1,
        "reps": 5,
        "weight": {
          "start": 60,
          "add": 5,
          "step": 2.5
        }
      },
      {
        "key": "plank",
        "name": "Plank",
        "target": 3,
        "sets": 3,
        "duration": {
          "start": 30,
          "add": 5,
          "every": 2,
          "max": 90
        }
      }
    ],
    "overrides": [
      {
        "weeks": [4, 8],
        "label": "Deload",
        "activities": {
          "*": {
            "sets": 3,
            "weight": {
              "scale": 0.9
            }
          },
          "deadlift": {
            "sets": 1
          }
        }
      }
