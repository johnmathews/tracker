    "format": "tracker-export",
    "version": 6,
    "trackers": [
      {
        "id": "exercise",
        "name": "Strength",
        "kind": "strength",
        "position": 0,
        "dailyTarget": 4,
        "startWeek": null,
        "endWeek": null
      },
      { "id": "exercise", "name": "Again", "kind": "strength", "position": 5 },
      { "id": "diet", "name": "Food", "kind": "strength", "position": 2 },
      {
        "id": "xk3j9a2b1c",
        "name": "  Upper body  ",
        "kind": "strength",
        "position": 3.6,
        "dailyTarget": 20,
        "startWeek": "2026-10-12",
        "endWeek": "2026-10-26"
      },
      {
        "id": "swim",
        "name": "Swimming",
        "kind": "cardio",
        "position": -4,
        "dailyTarget": 3,
        "startWeek": "2026-10-5",
        "endWeek": true
      },
      {
        "id": "fd",
        "name": "NNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNNN",
        "kind": "food",
        "position": "1",
        "dailyTarget": "3",
        "startWeek": 20261019
      },
      { "id": "far", "name": "Far", "kind": "food", "position": 99999, "dailyTarget": 0 },
      { "id": "yoga", "name": "Yoga", "kind": "yoga", "position": 4 },
      { "id": "bad id", "name": "Spaces", "kind": "food" },
