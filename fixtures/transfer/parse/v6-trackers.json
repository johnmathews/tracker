        "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "name": "Long id",
        "kind": "food"
      },
      { "id": "__proto__", "name": "Proto", "kind": "food" },
