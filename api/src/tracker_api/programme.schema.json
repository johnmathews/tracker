{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracker.itsa-pizza.com/api/programme.schema.json",
  "title": "Tracker programme",
  "description": "A multi-week exercise programme in the tracker-programme/1 format. The server's validator also checks what a schema can't: unique activity keys, parameter references, each week's value against the item's limits, and overrides against the activities.",
  "type": "object",
  "required": [
    "format",
    "name",
    "kind",
    "weeks",
    "activities"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "tracker-programme/1"
    },
    "name": {
      "type": "string",
      "maxLength": 60,
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "kind": {
      "enum": [
        "strength",
        "mobility",
        "cardio"
      ]
    },
    "weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 156
    },
    "dailyTarget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "params": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z0-9-]{1,40}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/param"
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30
    },
    "overrides": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "strength"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/$defs/strength.activity"
            }
          },
          "overrides": {
            "items": {
              "$ref": "#/$defs/strength.override"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mobility"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/$defs/mobility.activity"
            }
          },
          "overrides": {
            "items": {
              "$ref": "#/$defs/mobility.override"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cardio"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/$defs/cardio.activity"
            }
          },
          "overrides": {
            "items": {
              "$ref": "#/$defs/cardio.override"
            }
          }
        },
        "not": {
          "required": [
            "dailyTarget"
          ]
        }
      }
    }
  ],
  "$defs": {
    "reference": {
      "description": "A parameter, by its key: \"$squat\".",
      "type": "string",
      "pattern": "^\\$[a-z0-9-]{1,40}$"
    },
    "scale": {
      "description": "Scales the computed value before it is rounded.",
      "type": "object",
      "required": [
        "scale"
      ],
      "additionalProperties": false,
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "label",
        "unit",
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "\\S"
        },
        "unit": {
          "type": "string",
          "maxLength": 20,
          "minLength": 1,
          "pattern": "\\S"
        },
        "default": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "strength.target.literal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "strength.target.progression": {
      "type": "object",
      "required": [
        "start"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/strength.target.literal"
            },
            {
              "$ref": "#/$defs/reference"
            }
          ]
        },
        "add": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -7,
              "maximum": 7
            },
            {
              "$ref": "#/$defs/reference"
            }
          ]
        },
        "rate": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": -100,
              "maximum": 1000
            },
            {
              "$ref": "#/$defs/reference"
            }
          ]
        },
        "every": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52,
          "default": 1
        },
        "max": {
          "$ref": "#/$defs/strength.target.literal"
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "not": {
        "required": [
          "add",
          "rate"
        ]
      }
    },
    "strength.target.value": {
      "anyOf": [
        {
          "$ref": "#/$defs/strength.target.literal"
        },
        {
          "$ref": "#/$defs/reference"
        },
        {
          "$ref": "#/$defs/strength.target.progression"
        }
      ]
    },
    "strength.sets.literal": {
