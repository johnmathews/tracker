          "maxLength": 40,
          "minLength": 1,
          "pattern": "\\S"
        },
        "activities": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(\\*|[a-z0-9-]{1,40})$"
          },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "target": {
                "anyOf": [
